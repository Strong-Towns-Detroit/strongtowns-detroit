module detroit.article_iii.notice

concept LegalEntity
concept Organization is LegalEntity
concept PublicAgency is Organization
concept CityDepartment is PublicAgency
concept HearingForum is LegalEntity
concept CityGovernment is Organization

concept LegalInstrument

concept LegalMatter
concept Notice is LegalMatter
concept PublicHearing is LegalMatter

concept LegalAction

concept PublicationMedium
concept Newspaper is PublicationMedium

concept GeographicArea
concept Municipality is GeographicArea

entity Chapter50
  is LegalInstrument

entity Detroit
  is Municipality

entity CityOfDetroit
  is CityGovernment

entity BSEED
  is CityDepartment
  is HearingForum

action publish
  is LegalAction
  gerund "publishing"
  noun "publication"

relation department_of
  department: CityDepartment
  government: CityGovernment
  phrase
    "{department} is a department of {government}"

predicate requires_action
  authority: LegalInstrument
  action: LegalAction
  subject: LegalMatter
  phrase
    "{authority} requires {action:noun} of {subject}"

predicate responsible_for
  bearer: LegalEntity
  action: LegalAction
  subject: LegalMatter
  phrase
    "{bearer} is responsible for {action:gerund} {subject}"

relation notice_of
  notice: Notice
  event: PublicHearing
  phrase
    "{notice} is notice of {event}"

relation forum_for
  forum: HearingForum
  hearing: PublicHearing
  phrase
    "{forum} is the forum for {hearing}"

interpretive predicate has_general_circulation_in
  publication: Newspaper
  area: GeographicArea
  phrase
    "{publication} has general circulation in {area}"
  resolution
    status: open
    method: not defined by Chapter 50

rule minimum_bseed_notice
  id detroit.article_iii.50_3_10.bseed_notice

  source §50-3-10
    "Where the provisions of this chapter require that notice be published, the agency responsible for giving notice shall ensure that it is published in a newspaper of general circulation within the City."

  source §50-3-10(1)
    "At least 15 days prior to a public hearing being held before the Buildings, Safety Engineering, and Environmental Department."

  for every
    agency: PublicAgency
    hearing_notice: Notice
    hearing: PublicHearing

  given
    Chapter50 requires publication of hearing_notice
    agency is responsible for publishing hearing_notice
    hearing_notice is notice of hearing
    BSEED is the forum for hearing

  require duty
    bearer: agency
    action: publish
    subject: hearing_notice
    deadline: at least 15 days before hearing
    using some newspaper: Newspaper
      satisfying
        newspaper has general circulation in Detroit
