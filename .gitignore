data/.cache/
data/derived/
data/provider/
data/reviews/
data/sources/**/.staging/
# Immutable payloads live in R2. Git retains only the root snapshot manifest
# and promoted pointer, never copied raw evidence (including nested manifests).
data/sources/**/snapshots/**/*
!data/sources/*/snapshots/*/
!data/sources/*/snapshots/*/manifest.json

# GraphML network caches (isochrone toolkit builds these anywhere under --cache-dir)
**/*.graphml
# Regenerable byte-exact ordinance archive payload (about 151 MB).
data/zoning-ordinance/source-corpus.lossless.json

# Local Graphiti/Neo4j candidate graph state and ingestion receipts.
rust/zoning-rule-engine/graphiti-assist/.venv/
rust/zoning-rule-engine/graphiti-assist/data/
rust/zoning-rule-engine/graphiti-assist/.env
rust/zoning-rule-engine/**/target/

# ──────────────────────────────────────────────
# Regenerable analysis payloads
# Source data is fetched, derived data is rebuilt; neither belongs in the repo.
# ──────────────────────────────────────────────

# Downloaded City of Detroit base-units geometry (~464 MB).
# Rebuilt by pipelines/parcel-data/fetch_parcels.py and the base-units scripts.
projects/detroit-land-use-forum/base-units-geometry/data/

# Rendered exhibit bundles (~428 MB). Regenerated by build_conference_bundle.py
# and build_print_sheets.py; the SVG/HTML embed full-resolution rasters.
projects/detroit-land-use-forum/conference-print/
projects/detroit-land-use-forum/conference-canonical/

# Municode snapshot page rasters (~114 MB), alongside the already-ignored .docx.
resources/municode/**/*.png

# Compiled ordinance payloads, rebuilt by pipelines/zoning/compile_ordinance.py.
data/zoning-ordinance/executable-rules.json
data/zoning-ordinance/source-corpus.json
data/zoning-ordinance/chapter-50-package.json
data/zoning-ordinance/candidate-provisions.json

# Source-span and semantic review pages, rebuilt by the article review scripts.
artifacts/

# Intermediate spatial caches for the LIHTC site screen; rebuilt by
# build_qct_join.py and assembly.py. The published boards stay tracked.
projects/detroit-land-use-forum/lihtc-site-selection/output/*.parquet
projects/detroit-land-use-forum/lihtc-site-selection/output/*.gpkg

# Browser-automation session logs.
.playwright-mcp/
