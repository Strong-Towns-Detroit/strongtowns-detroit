# Large data files (downloaded / generated)
# ──────────────────────────────────────────────
# Parcel geospatial data (939MB GeoJSON, 653MB + 363MB GeoPackages)
pipelines/parcel-data/Parcels.geojson
pipelines/parcel-data/parcels_with_compliance.gpkg
pipelines/parcel-data/parcels_with_buildability.gpkg

# Raw and cleaned parcel CSVs (172MB + 184MB)
pipelines/parcel-data/parcel-data.csv
pipelines/parcel-data/parcel-data-cleaned.csv

# Building permits (16MB)
pipelines/parcel-data/building-permits.csv

# Street network GeoPackage (70MB)
pipelines/housingDataAnalysis/street_simplification/detroit_street_network.gpkg

# Zoning ordinance .docx source files (111MB total)
