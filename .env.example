CENSUS_API_KEY=your_key_here
TRAVELTIME_APP_ID=your_app_id_here
TRAVELTIME_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-pro-preview

# Local Graphiti ontology-assistance service. Graphiti uses OpenAI for semantic
# extraction, embeddings, and reranking; Neo4j stores the candidate graph.
OPENAI_API_KEY=your_openai_api_key_here
GRAPHITI_LLM_MODEL=gpt-5.4-mini
GRAPHITI_SMALL_MODEL=gpt-5.4-mini
GRAPHITI_REASONING_EFFORT=low
GRAPHITI_EMBEDDING_MODEL=text-embedding-3-small
GRAPHITI_GROUP_ID=detroit-chapter-50-candidates
GRAPHITI_TELEMETRY_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=choose_a_local_password

# Detroit eLAPS/Accela intake-date enrichment.
# Anonymous public access requires an Accela citizen-app ID plus the agency and
# environment headers. Alternatively, an access token can be used. Never commit
# real credentials.
ACCELA_APP_ID=
ACCELA_ACCESS_TOKEN=
ACCELA_AGENCY=DETROIT
ACCELA_ENVIRONMENT=PROD
ACCELA_API_URL=https://apis.accela.com/v4/search/records
