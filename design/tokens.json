{
  "$comment": [
    "Canonical Land Forum / Strong Towns Detroit design tokens.",
    "Generated into CSS, TypeScript, and Python by design/build_tokens.py.",
    "Edit this file, never a generated one."
  ],

  "color": {
    "brand": {
      "navy": {
        "value": "#0c2340",
        "use": "Primary type, dark ground, and the 'meets standard' data state."
      },
      "red": {
        "value": "#c8102e",
        "use": "Identity red: eyebrows, links, focus rings, rules. Punchier than the map red on purpose."
      },
      "gold": { "value": "#ffb549", "use": "Accent and third categorical step." },
      "cream": { "value": "#fffaf0", "use": "Page and exhibit ground." },
      "paper": { "value": "#f4efe5", "use": "Recessed band behind a section." },
      "line": { "value": "#d9d1c3", "use": "Hairline rules and borders." },
      "inkSoft": { "value": "#516175", "use": "Secondary prose." }
    },

    "$conflict": [
      "Two reds are in production and the split looks deliberate, so both are kept:",
      "brand.red #c8102e drives identity (website, height-comparison, use-spacing,",
      "parking-by-project-type); data.fails #c83a3a is the softer brick used for map",
      "fills at parcel scale (minimum-lot-size, land-value-estimate, bza-repeat-sites,",
      "bza-use-types). Confirm this reading before collapsing them."
    ],

    "data": {
      "fails": {
        "value": "#c83a3a",
        "use": "Fails the standard as measured. Desaturated against brand.red so dense parcel fills do not vibrate against cream."
      },
      "meets": {
        "value": "#0c2340",
        "use": "Meets the standard as measured."
      },
      "absent": {
        "value": "#e4dfd6",
        "use": "Not evaluated, or outside the scope of the rule. Never implies compliance."
      },
      "muted": {
        "value": "#647184",
        "use": "Supporting labels inside exhibits."
      },
      "road": {
        "value": "#0c2340",
        "use": "Major and arterial road context, drawn at low opacity."
      }
    },

    "category": {
      "$comment": "BZA request types. Order is the published CATEGORY_ORDER.",
      "administrative_or_community_appeal": { "value": "#0c2340", "label": "Administrative/community appeal" },
      "parking_supply": { "value": "#c83a3a", "label": "Parking supply" },
      "use_spacing_separation": { "value": "#0072ce", "label": "Use spacing/separation" },
      "setbacks_yards": { "value": "#e57f00", "label": "Setbacks/yards" },
      "nonconforming_use_or_structure": { "value": "#43617f", "label": "Nonconforming use/structure" },
      "lot_coverage": { "value": "#d85b68", "label": "Lot coverage" },
      "lot_dimensions": { "value": "#75a7db", "label": "Lot dimensions" },
      "height": { "value": "#b96f00", "label": "Height" },
      "parking_layout": { "value": "#173e67", "label": "Parking layout" },
      "screening_landscaping": { "value": "#a92f43", "label": "Screening/landscaping" },
      "signs_billboards": { "value": "#5f8fbe", "label": "Signs/billboards" },
      "floor_area_bulk": { "value": "#d2a944", "label": "Floor area/bulk" },
      "multiple_buildings": { "value": "#647184", "label": "Multiple buildings" },
      "open_recreation_space": { "value": "#8f5261", "label": "Open/recreation space" },
      "fences_walls": { "value": "#90b8e8", "label": "Fences/walls" },
      "loading": { "value": "#927035", "label": "Loading" },
      "unspecified": { "value": "#73777d", "label": "Request not specified" }
    }
  },

  "font": {
    "serif": {
      "value": "\"Source Serif 4\", \"Source Serif 4 Fallback\", Georgia, \"Times New Roman\", serif",
      "use": "Editorial: headlines, dek, prose, data figures."
    },
    "sans": {
      "value": "\"Inter\", \"Inter Fallback\", system-ui, -apple-system, Arial, sans-serif",
      "use": "Interface: labels, controls, eyebrows, legends."
    }
  },

  "tracking": {
    "caps": { "value": "0.08em", "use": "All-caps. Always positive." },
    "display": { "value": "-0.018em", "use": "Lowercase display type." }
  },

  "exhibit": {
    "$comment": "Frozen poster geometry, matching the published conference exhibits.",
    "width": 1600,
    "height": 1100,
    "map": { "x": 48, "y": 205, "width": 1015, "height": 680 },
    "column": { "x": 1120 }
  }
}
