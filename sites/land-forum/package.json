{
  "name": "land-forum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "vinext build && node scripts/prepare_dist.mjs",
    "start": "vinext start",
    "lint": "npm run typecheck",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "node scripts/check_public_origin.mjs && npm run build && node scripts/check_worker_assets.mjs && vinext-cloudflare deploy --config dist/server/wrangler.json",
    "tokens": "python3 ../../design/build_tokens.py",
    "tokens:check": "python3 ../../design/build_tokens.py --check",
    "test": "node --experimental-strip-types --test lib/**/*.test.ts",
    "typecheck": "node scripts/typecheck.mjs",
    "test:browser": "node --test tests/browser.test.mjs"
  },
  "dependencies": {
    "@strongtowns/graphics-browser": "file:../../projects/graphics/vendor/strongtowns-graphics-browser-0.2.0.tgz",
    "@vinext/cloudflare": "^1.0.0-beta.4",
    "next": "^16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-server-dom-webpack": "^19.2.8",
    "vinext": "^1.0.0-beta.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.48.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-rsc": "^0.5.32",
    "playwright": "^1.62.1",
    "typescript": "^5.8.3",
    "vite": "^8.1.5",
    "wrangler": "^4.115.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.1.5",
    "lightningcss-linux-x64-gnu": "1.33.0"
  },
  "type": "module"
}
