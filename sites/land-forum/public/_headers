# Cloudflare Pages / Workers Assets header rules.
#
# NOTE: this file REPLACES the _headers vinext generates — it does not merge
# with it. The `/_next/static/*` rule below is vinext's, reproduced here
# verbatim; deleting it silently drops immutable caching on every hashed
# build asset.

# Cache content-hashed assets immutably (was generated by vinext)
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

# The font filenames are not content-hashed, so a year of `immutable` would
# strand repeat visitors on a stale face if a subset is ever regenerated.
# Thirty days is the compromise; bump the filenames if that ever changes.
/fonts/*
  Cache-Control: public, max-age=2592000
  Access-Control-Allow-Origin: *

/og-default.png
  Cache-Control: public, max-age=86400

/icon.svg
  Cache-Control: public, max-age=604800
/favicon.ico
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
