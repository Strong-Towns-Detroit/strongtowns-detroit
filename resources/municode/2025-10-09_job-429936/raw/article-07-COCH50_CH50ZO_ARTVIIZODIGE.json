{"Docs":[{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8075,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":3,"TitleHtml":"<div class=\"chunk-title\">ARTICLE VII. - ZONING DISTRICTS (IN GENERAL)</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE","Title":"ARTICLE VII. - ZONING DISTRICTS (IN GENERAL)","Content":"<div class=\"chunk-content\"><br></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8076,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-1. - Establishment of zoning districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-1ESZODI","Title":"Sec. 50-7-1. - Establishment of zoning districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               For the purpose of this chapter, the City is hereby divided into the zoning districts\n               that are delineated in <a href=\"\" data-chunk-id=\"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-2REDI\" class=\"section-link\" data-product-id=\"10649\">Section 50-7-2</a> through <a href=\"\" data-chunk-id=\"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-5SPDI\" class=\"section-link\" data-product-id=\"10649\">Section 50-7-5</a> of this Code.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-1; Ord. No. 11-05, § 1(61-7-1), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8077,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-2. - Residential Districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-2REDI","Title":"Sec. 50-7-2. - Residential Districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Residential districts within the City are as follows:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R1 Single-Family Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R2 Two-Family Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R3 Low Density Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R4 Thoroughfare Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R5 Medium Density Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (6)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  R6 High Density Residential District.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-2; Ord. No. 11-05, § 1(61-7-2), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8078,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-3. - Business Districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-3BUDI","Title":"Sec. 50-7-3. - Business Districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Business districts within the City are as follows:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B1 Restricted Business District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B2 Local Business and Residential District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B3 Shopping District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B4 General Business District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B5 Major Business District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (6)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  B6 General Services District.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-3; Ord. No. 11-05, § 1(61-7-3), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8079,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-4. - Industrial Districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-4INDI","Title":"Sec. 50-7-4. - Industrial Districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Industrial districts within the City are as follows:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  M1 Limited Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  M2 Restricted Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  M3 General Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  M4 Intensive Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  M5 Special Industrial District.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-4; Ord. No. 11-05, § 1(61-7-4), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8080,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-5. - Special districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-5SPDI","Title":"Sec. 50-7-5. - Special districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Special districts and overlay areas within the City are as follows:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  PD Planned Development District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  P1 Open Parking District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  PC Public Center District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  PCA Public Center Adjacent District (Restricted Central Business District).\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  TM Transitional-Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (6)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  PR Parks and Recreation District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (7)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  W1 Waterfront-Industrial District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (8)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  MKT Market and Distribution District.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (9)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  SD1 Special Development District, Small-Scale, Mixed-Use.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (10)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  SD2 Special Development District, Mixed-Use.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (11)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  SD4 Special Development District, Riverfront Mixed-Use.\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (12)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  SD5 Special Development District, Casinos.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-5; Ord. No. 11-05, § 1(61-7-5), eff. 5-28-2005; Ord. No. 13-11,\n               § 1(61-7-5), eff. 8-23-2011; Ord. No. 38-14, § 1(61-7-5), eff. 10-16-2014; <a class=\"ordinance-link\" href=\"\" data-product-id=\"10649\" data-ordinance-id=\"1231501\">Ord. No. 2022-17</a>, § 1, eff. 10-4-2022)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8081,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-6. - Overlay Areas.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-6OVAR","Title":"Sec. 50-7-6. - Overlay Areas.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               As provided for in Article XI, Division 14, of this chapter, certain areas of the\n               City, while classified within certain zoning districts, are geographically sub-classified\n               as overlay areas. Overlay areas include the following:\n               \n               <p class=\"incr1\">\n                  (1)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Gateway Radial Thoroughfare Overlay Areas;\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (2)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Traditional Main Street Overlay Areas;\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (3)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Major Corridor Overlay Areas;\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (4)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Grand Boulevard Overlay Area;\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (5)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Downtown and Riverfront Overlay Areas; and\n                  </p>\n               \t\t\n               \n               <p class=\"incr1\">\n                  (6)\n                  </p>\n               \t\t\n               <p class=\"content2\">\n                  Development Improvement Area.\n                  </p>\n               \t\t\n               \n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-6; Ord. No. 11-05, § 1(61-7-6), eff. 5-28-2005; Ord. No. 20-05,\n               § 1(61-7-6), eff. 5-29-2005; Ord. No. 13-11, § 1(61-7-6), eff. 8-23-2011; Ord. No.\n               <a class=\"ordinance-link\" href=\"\" data-product-id=\"10649\" data-ordinance-id=\"1071454\">2020-21</a>, § 1, eff. 8-8-2020)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8082,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-7. - Flood hazard overlay areas.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-7FLHAOVAR","Title":"Sec. 50-7-7. - Flood hazard overlay areas.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The boundaries of the flood hazard overlay areas are set out in <a href=\"\" data-chunk-id=\"COCH50_CH50ZO_ARTXIVDEST_DIV5FLHAAR_S50-14-525DEFLHAOVAR\" class=\"section-link\" data-product-id=\"10649\">Section 50-14-525</a> of this Code.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-7; Ord. No. 11-05, § 1(61-7-7), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8083,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-8. - Historic Districts.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-8HIDI","Title":"Sec. 50-7-8. - Historic Districts.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               Any area that has been designated by the City Council as a historic district shall\n               be designated in this chapter with the addition of the suffix \"H.\" When a district\n               zoning designation is followed by the letter \"H,\" such as R1-H, the property within\n               such area shall also comply with the requirements of Chapter 21, Article II, of this\n               Code, <span class=\"ital\">Historic Districts and Landmarks.</span> It is included solely for reference purposes and is not, and shall not be construed\n               to be, a part of this chapter. Historic districts are further identified on the zoning\n               district maps by use of a pattern of dots.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-8; Ord. No. 11-05, § 1(61-7-8), eff. 5-28-2005; Ord. No. 13-11,\n               § 1(61-7-8), eff. 8-23-2011)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8084,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-9. - Zoning district hierarchy.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-9ZODIHI","Title":"Sec. 50-7-9. - Zoning district hierarchy.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               In general, the organization of the residential, business, and industrial zoning districts\n               shall be considered as hierarchical. The zoning districts included in Article X of\n               this chapter (Industrial Districts) permit more intensive land uses than those districts\n               listed in Article IX of this chapter (Business Districts). The zoning districts listed\n               in Article IX of this chapter permit more intensive land uses than the districts listed\n               in Article VIII of this chapter (Residential Districts). Similarly, within a given\n               article, zoning districts bearing a higher number shall be deemed more intensive than\n               districts bearing a lower number, such as the M4 District shall be deemed more intensive\n               than the M2 District. Such a hierarchy does not apply to the zoning districts listed\n               in Article XI of this chapter (Special Districts).\n               </p>\n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-9; Ord. No. 11-05, § 1(61-7-9), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8085,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Sec. 50-7-10. - Zoning map.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_S50-7-10ZOMA","Title":"Sec. 50-7-10. - Zoning map.","Content":"<div class=\"chunk-content\">\n            <p class=\"p0\">\n               The boundaries of the zoning districts that are established by this chapter are shown\n               in the series of maps, which have been adopted and included as Article XVII of this\n               chapter. In case of any dispute regarding the zoning classification of property subject\n               to this chapter, the zoning maps maintained in the Office of the City Planning Commission\n               shall control. Questions or disputes regarding zoning designations shown on a zoning\n               map shall be handled by the Planning and Development Department.\n               </p>\n            <p class=\"historynote0\">\n               (Code 1984, § 61-7-10; Ord. No. 11-05, § 1(61-7-10), eff. 5-28-2005)\n               </p></div>","SortDate":null,"Footnotes":null},{"DocType":1,"IsAmended":false,"IsUpdated":false,"CompareStatus":4,"DocOrderId":8086,"AmendedBy":[],"Notes":[],"Drafts":[],"ChunkGroupStartingNodeId":"COCH50_CH50ZO_ARTVIIZODIGE","NodeDepth":4,"TitleHtml":"<div class=\"chunk-title\">Secs. 50-7-11—50-7-30. - Reserved.</div>","ShouldShowMiniToc":false,"Id":"COCH50_CH50ZO_ARTVIIZODIGE_SS50-7-11--50-7-30RE","Title":"Secs. 50-7-11—50-7-30. - Reserved.","Content":"<div class=\"chunk-content\"></div>","SortDate":null,"Footnotes":null}],"NewOrds":[],"PdfUrl":null,"LastOrd":null,"PrevNode":{"Id":"COCH50_CH50ZO_ARTVIRE_SS50-6-1--50-6-200RE","Heading":"Secs. 50-6-1—50-6-200. - Reserved.","NodeDepth":4,"HasChildren":false,"ParentId":"COCH50_CH50ZO_ARTVIRE","DocOrderId":8074,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"NextNode":{"Id":"COCH50_CH50ZO_ARTVIIIREZODI","Heading":"ARTICLE VIII. - RESIDENTIAL ZONING DISTRICTS","NodeDepth":3,"HasChildren":true,"ParentId":"COCH50_CH50ZO","DocOrderId":8087,"Children":[],"Data":{"NodeKey":null,"IsUpdated":false,"IsAmended":false,"HasAmendedDescendant":false,"CompareStatus":4,"DocType":1,"DepthOverride":null,"ChunkGroupStartingId":null}},"ShowToc":false}